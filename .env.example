# Where market data comes from.
#   synthetic — deterministic generated data, no credentials needed (default)
#   fmp       — Financial Modeling Prep, requires FMP_API_KEY
#   massive   — real massive.com API, requires MASSIVE_API_KEY (not yet implemented)
DATA_PROVIDER=synthetic

# massive.com API key. Server-side ONLY — never prefix with VITE_, or Vite will
# inline it into the browser bundle. Required only when DATA_PROVIDER=massive.
MASSIVE_API_KEY=
MASSIVE_BASE_URL=https://api.massive.com

# Where the proxy keeps named layouts and watchlists (JSON). Gitignored under /data/.
WORKSPACE_FILE=data/workspace.json
ALERTS_FILE=data/alerts.json
# Upstream calls a minute for the alert checker. Not used with DATA_PROVIDER=synthetic.
ALERT_CALL_BUDGET=150

# Proxy listen port. Vite forwards /api/* here in dev (see vite.config.ts).
SERVER_PORT=8787

# Synthetic fault injection — makes the client's error and loading states reachable
# in development instead of theoretical. All default to off.
SYNTHETIC_LATENCY_MS=0
SYNTHETIC_RATE_LIMIT_RATE=0
SYNTHETIC_ERROR_RATE=0
SYNTHETIC_DELAYED=false

# Client-side: use MSW mocks instead of the real proxy. Dev only; non-secret.
# Default is true in `vite dev`. Set false to run the UI against the real server.
VITE_USE_MOCKS=false

# Financial Modeling Prep API key. Server-side ONLY. Required when DATA_PROVIDER=fmp.
# Free tier: daily/weekly only, all intraday returns HTTP 402.
# Starter: 5min, 15min and 1hour intraday too; 1min returns HTTP 402.
FMP_API_KEY=

# AI helper (docs/AI_HELPER_PLAN.md). Leave the key empty to turn the AI endpoints off.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
AI_DAILY_CALL_LIMIT=50
AI_ANALYSES_FILE=data/ai-analyses.json
